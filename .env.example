# Copy this file to `.env` and fill in real values. Never commit the real `.env` file.

# Meta / WhatsApp Cloud API access token (from the Meta App Dashboard).
WHATSAPP_TOKEN=your_meta_access_token_here

# The WhatsApp Business "Phone Number ID" (not the phone number itself).
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here

# A secret string you choose yourself. Enter this same value in the Meta
# dashboard when configuring the webhook so the GET /webhook verification
# handshake succeeds.
WHATSAPP_VERIFY_TOKEN=choose_any_secret_string_here

# Groq API key (https://console.groq.com/keys) — used for voice note
# transcription (Whisper-compatible endpoint) and transcript cleanup (LLM).
GROQ_API_KEY=your_groq_api_key_here

# Async PostgreSQL connection string (note the `+asyncpg` driver suffix —
# required for our async SQLAlchemy engine). On Railway, add a Postgres
# plugin and it will provide this value for you (as $DATABASE_URL, which
# you'll need to rewrite from `postgresql://` to `postgresql+asyncpg://`).
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# Meta App Dashboard -> App Settings -> Basic -> App Secret. Used to
# verify the X-Hub-Signature-256 header on every incoming webhook POST.
APP_SECRET=your_meta_app_secret_here

# Max voice notes a single user can process per UTC calendar day.
DAILY_VOICE_LIMIT=20

# development | staging | production
APP_ENV=development
